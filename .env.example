# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env ke git.

# API key YouTube Data API v3 (gratis, 100 pencarian/hari).
# Cara membuat: lihat tab "Bantuan" di dalam aplikasi atau README.md
YOUTUBE_API_KEY=

# Opsional: daftar instance Invidious untuk fallback tanpa key, pisah dengan koma.
INVIDIOUS_INSTANCES=https://inv.nadeko.net,https://invidious.nerdvpn.de,https://yewtu.be
